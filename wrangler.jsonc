{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oa-digital-dashboard-system-dev",
  "account_id": "822dc6b6eb04fe72ff5896cc63577014",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Cloudflare creates the DNS record and certificate on deploy (the zone is in this account).
  // Sign-in only works on SITE_URL, so this must match SITE_URL on the Convex deployment.
  "routes": [
    { "pattern": "poweroavantage.com", "custom_domain": true }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "oa-digital-dashboard-system-dev"
    }
  ],
  "observability": {
    "enabled": true
  }
}
